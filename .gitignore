# Environment secrets
.env
.env.local
out/
.remotion/
*.log

# Python environment for Kokoro (recreated by setup.ps1)
.venv/
__pycache__/
node_modules/
examples/
# Rhubarb binary (~83 MB, re-downloaded by setup.ps1)
tools/
youtube_token.json
# Vast.ai machines that failed to start; kept locally so they are not re-rented
.vast_bad_hosts.json
# Generated narration audio (re-created by `npm run voice`)
# Keep the small IndicF5 zero-shot reference voices so a fresh Vast.ai clone
# still has the prompt audio the remote TTS server needs.
public/audio/*
!public/audio/prompts/
public/audio/prompts/*
!public/audio/prompts/indicf5/
public/images/

# Generated grain texture and ambience beds (re-created by `npm run assets`)
public/textures/
