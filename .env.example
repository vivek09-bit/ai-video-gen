# ============================================================
# Tube2DScript Environment Variables
# Create a copy of this file named `.env` in this directory:
#   C:\Users\vkg12\Downloads\tube2dscript\.env
# ============================================================

# LLM Providers (for script writing)
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
OMNIROUTE_API_KEY=
OPENAI_API_KEY=

# Image Providers (for background art)
# Options: local (100% offline SD 1.5 + LCM on CPU/OpenVINO) | fetch (100% free related image search via Lexica / Unsplash) | pollinations (free AI) | fireworks | together | fal | replicate | openai
# Set IMAGE_PROVIDER=local for 100% offline local generation without any API calls or internet dependency!
IMAGE_PROVIDER=fetch
IMAGE_MODEL=SimianLuo/LCM_Dreamshaper_v7

# Visual Themes (for caption styling, colors, and stage backgrounds)
# Options: auto | random | random_genre | blood_red | cyber_neon | golden_radiance | amethyst_dream | emerald_forest | midnight_blue | sunset_glow | monochrome_noir | toxic_lime | solar_flare | synthwave | ice_glacier | royal_velvet | sepia_vintage | pastel_whimsy | matrix_green | desert_dusk | crimson_gothic | citrus_burst | nordic_frost | #hex_color
THEME=auto

# Additional Image Keys
FAL_KEY=
REPLICATE_API_TOKEN=
