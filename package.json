{
  "name": "tube2dscript",
  "version": "1.0.0",
  "private": true,
  "description": "Turn a written script into a long-form 2D faceless video. Zero AI-generation cost: narration via edge-tts, visuals rendered deterministically with Remotion.",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "assets": ".venv\\Scripts\\python.exe scripts\\make_assets.py",
    "new": ".venv\\Scripts\\python.exe scripts\\new_video.py",
    "batch": ".venv\\Scripts\\python.exe scripts\\batch.py",
    "images": ".venv\\Scripts\\python.exe scripts\\generate_images.py",
    "voice": ".venv\\Scripts\\python.exe scripts\\tts.py",
    "voices": ".venv\\Scripts\\python.exe scripts\\tts.py --voices",
    "indicf5:setup": "powershell -ExecutionPolicy Bypass -File examples/indicf5/setup.ps1",
    "indicf5": "cd examples\\indicf5 && .venv-indicf5\\Scripts\\python.exe indicf5_voices.py",
    "tokens": ".venv\\Scripts\\python.exe scripts\\token_report.py",
    "upload": ".venv\\Scripts\\python.exe scripts\\uploader.py",
    "upload:check": ".venv\\Scripts\\python.exe scripts\\uploader.py --check",
    "upload:dry": ".venv\\Scripts\\python.exe scripts\\uploader.py --dry-run",
    "test": ".venv\\Scripts\\python.exe scripts\\test_phonemise.py && .venv\\Scripts\\python.exe scripts\\test_audio.py && .venv\\Scripts\\python.exe scripts\\test_story.py && .venv\\Scripts\\python.exe scripts\\test_providers.py",
    "test:phonemise": ".venv\\Scripts\\python.exe scripts\\test_phonemise.py",
    "test:audio": ".venv\\Scripts\\python.exe scripts\\test_audio.py",
    "test:story": ".venv\\Scripts\\python.exe scripts\\test_story.py",
    "test:providers": ".venv\\Scripts\\python.exe scripts\\test_providers.py",
    "studio": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "make": "npm run assets && npm run voice && npm run render",
    "preview": "npm run voice && remotion render Main out/preview.mp4 --frames 0-300",
    "bot": ".venv\\Scripts\\python.exe -m bot.main"
  },
  "dependencies": {
    "@remotion/cli": "4.0.418",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.418"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}