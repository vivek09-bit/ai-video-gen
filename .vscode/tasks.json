{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "setup",
			"detail": "One-time: Python 3.12 + Kokoro + Rhubarb",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"setup"
			],
			"problemMatcher": []
		},
		{
			"label": "assets",
			"detail": "Generate grain, ambience beds and SFX",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"assets"
			],
			"problemMatcher": []
		},
		{
			"label": "voice",
			"detail": "Narration, word timings and lip sync",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"voice"
			],
			"problemMatcher": []
		},
		{
			"label": "render",
			"detail": "Render script.json to out/video.mp4",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"render"
			],
			"problemMatcher": []
		},
		{
			"label": "studio",
			"detail": "Remotion studio with live scrubbing",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"studio"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "typecheck",
			"detail": "TypeScript check across the renderer",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "test",
			"detail": "Verify word-timing alignment",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"test"
			],
			"problemMatcher": []
		},
		{
			"label": "tokens",
			"detail": "Report token cost per minute of video",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"tokens"
			],
			"problemMatcher": []
		},
		{
			"label": "wait-e2e",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Start-Sleep -Seconds 300; Get-ChildItem out -File | Select-Object Name,Length"
			],
			"isBackground": false
		},
		{
			"label": "verify-e2e",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-ChildItem out -File | Select-Object Name,Length; Write-Host ---; & .venv\\Scripts\\python.exe scripts\\token_report.py | Select-Object -First 20"
			],
			"isBackground": false
		},
		{
			"label": "verify-final",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"_verify.ps1"
			],
			"isBackground": false
		},
		{
			"label": "wrapup",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Force _verify.ps1 -ErrorAction SilentlyContinue; Write-Host \"=== npm run test ===\"; npm run test --silent 2>&1 | Select-Object -Last 3; Write-Host \"\"; Write-Host \"=== typecheck ===\"; npx tsc --noEmit; Write-Host \"tsc=$LASTEXITCODE\"; Write-Host \"\"; Write-Host \"=== deliverables ===\"; Get-ChildItem out -File | ForEach-Object { '{0}  {1:N1} MB' -f $_.Name, ($_.Length/1MB) }"
			],
			"isBackground": false
		},
		{
			"label": "wrapup2",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Force _verify.ps1 -ErrorAction SilentlyContinue; npm run test --silent 2>&1 | Select-Object -Last 3; npx tsc --noEmit; Write-Host tsc=$LASTEXITCODE; Get-ChildItem out -File | Select-Object Name,Length"
			],
			"isBackground": false
		},
		{
			"label": "rm-character",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Force src\\components\\character\\Character.tsx; Write-Host removed"
			],
			"isBackground": false
		},
		{
			"label": "acting-plan",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"npx tsc --noEmit; Write-Host tsc=$LASTEXITCODE; Write-Host \"\"; & .venv\\Scripts\\python.exe scripts\\new_video.py --topic \"aadhi raat ki ginti\" --minutes 3 --dry-run"
			],
			"isBackground": false
		},
		{
			"label": "char-run",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"_test.ps1"
			],
			"isBackground": false
		},
		{
			"label": "wait-char",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Start-Sleep -Seconds 330; Get-ChildItem out -File | Select-Object Name,Length"
			],
			"isBackground": false
		},
		{
			"label": "verify-acting",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-ChildItem out -File | Select-Object Name,Length; Write-Host ---; foreach ($f in 500,600,1400,1500) { npx remotion still Main \"out/act-$f.png\" --frame=$f 2>&1 | Out-Null }; & .venv\\Scripts\\python.exe scripts\\_verify_acting.py"
			],
			"isBackground": false
		},
		{
			"label": "rm-verify",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Force scripts\\_verify_acting.py; Write-Host removed"
			],
			"isBackground": false
		},
		{
			"label": "verify-acting2",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"_test.ps1"
			],
			"isBackground": false
		}
	]
}