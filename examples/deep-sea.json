  "scenes": [
    {
      "id": "intro",
      "headline": "The Deep Sea",
      "subtext": "A short demo of the tube2dscript pipeline",
      "cast": [{"id": "maya", "x": 0.5, "scale": 1}],
      "lines": [
        {
          "character": "maya",
          "text": "Two thirds of our planet is ocean, and almost all of it is completely dark."
        }
      ],
      "background": {
        "type": "gradient",
        "from": "#04101c",
        "to": "#0f3352",
        "angle": 160
      }
    },
    {
      "id": "dialogue",
      "headline": "Four Thousand Meters Down",
      "cast": [
        {"id": "maya", "x": 0.29, "scale": 0.92, "flip": true},
        {"id": "sam", "x": 0.71, "scale": 0.92}
      ],
      "lines": [
        {
          "character": "sam",
          "text": "At four thousand meters, the pressure would crush a steel submarine like a tin can."
        },
        {
          "character": "maya",
          "text": "And yet something down there is making its own light."
        }
      ],
      "background": {
        "type": "pattern",
        "pattern": "grid",
        "bg": "#061321",
        "line": "#153a5c"
      }
    },
    {
      "id": "life",
      "headline": "Yet Life Finds A Way",
      "bullets": [
        "Anglerfish that make their own light",
        "Giant squid the size of a bus",
        "Bacteria that feed on bare rock"
      ],
      "background": {
        "type": "pattern",
        "pattern": "dots",
        "bg": "#071726",
        "line": "#1e4a70"
      },
      "lines": [
        {
          "character": null,
          "text": "Yet life survives here. Anglerfish that make their own light, giant squid the size of a bus, and bacteria that feed on bare rock."
        }
      ]
    },
    {
      "id": "outro",
      "headline": "We Have Mapped 26%",
      "subtext": "The rest is still a blank page",
      "cast": [{"id": "sam", "x": 0.5, "scale": 1}],
      "lines": [
        {
          "character": "sam",
          "text": "We have mapped only twenty six percent of the sea floor in detail. The rest is still a blank page."
        }
      ],
      "background": {
        "type": "gradient",
        "from": "#0a1a2b",
        "to": "#020a12",
        "angle": 200
      }
    }
